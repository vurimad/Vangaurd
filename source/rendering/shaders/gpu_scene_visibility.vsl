#include "gpu_scene_types.hlsli"

static const uint VG_GPU_VISIBILITY_THREADS = 128u;
static const uint VG_GPU_INSTANCE_ACTIVE = 1u << 0u;
static const uint VG_GPU_INSTANCE_FORCE_VISIBLE = 1u << 4u;
static const uint VG_GPU_PRIMITIVE_INDEXED = 1u << 0u;
static const uint VG_GPU_GEOMETRY_RESIDENT = 1u << 0u;
static const uint VG_GPU_GEOMETRY_INDEXED = 1u << 1u;
static const uint VG_GPU_VIEW_ORTHOGRAPHIC = 1u << 1u;
static const uint VG_GPU_GEOMETRY_WORK_MIRRORED = 1u << 0u;
static const uint VG_GPU_VISIBILITY_CULLED = 0u;
static const uint VG_GPU_VISIBILITY_VISIBLE = 1u;
static const uint VG_GPU_VISIBILITY_REJECTED = 2u;
static const uint VG_GPU_VISIBILITY_REJECTED_PACK = 256u;

struct GpuVisibilityWorkRange
{
    uint candidateOffset;
    uint candidateCount;
    uint viewIndex;
    uint resultIndex;
};

struct GpuVisibilityResultRange
{
    uint visibleOffset;
    uint visibleCapacity;
    uint counterIndex;
    uint viewIndex;
};

struct GpuVisibilityCounters
{
    uint visibleCount;
    uint culledCount;
    uint overflowCount;
    uint rejectedCount;
};

struct GpuVisibleInstance
{
    uint instance;
    uint renderable;
    uint lod;
    uint placementRevision;
};

struct GpuVisibilityConstants
{
    uint tableDirectoryDescriptor;
    uint pageDirectoryDescriptor;
    uint candidateDescriptor;
    uint workRangeDescriptor;
    uint viewDescriptor;
    uint resultRangeDescriptor;
    uint visibleDescriptor;
    uint counterDescriptor;
    uint workRangeCount;
    uint instanceTable;
    uint renderableTable;
    uint layoutVersion;
    float worldCellSize;
    uint reserved0;
    uint reserved1;
    uint reserved2;
};

struct GpuGeometryExpansionWorkRange
{
    uint visibleOrdinal;
    uint visibleCount;
    uint resultIndex;
    uint prefixBlockIndex;
};

struct GpuGeometryExpansionItem
{
    uint validWorkCount;
    uint rejectedWorkCount;
    uint outputOffset;
    uint outputCapacity;
};

struct GpuGeometryWork
{
    uint instance;
    uint primitive;
    uint geometry;
    uint material;
    uint phase;
    uint shell;
    uint bin;
    uint flags;
};

struct GpuGeometryResultRange
{
    uint workOffset;
    uint workCapacity;
    uint binOffset;
    uint binCapacity;
    uint instanceOffset;
    uint instanceCapacity;
    uint argumentOffset;
    uint argumentCapacity;
    uint expansionBlockOffset;
    uint expansionBlockCount;
    uint binBlockOffset;
    uint binBlockCount;
};

struct GpuGeometryCounters
{
    uint requestedWorkCount;
    uint emittedWorkCount;
    uint rejectedWorkCount;
    uint expansionOverflowCount;
    uint invalidBinWorkCount;
    uint instanceOverflowCount;
    uint visibleBinCount;
    uint rejectedIndirectBinCount;
};

struct GpuGeometryBinItem
{
    uint instanceCount;
    uint instanceCursor;
    uint instanceOffset;
    uint instanceCapacity;
};

struct GpuGeometryWorkRange
{
    uint workOrdinal;
    uint workCount;
    uint resultIndex;
    uint reserved;
};

struct GpuGeometryPrefixWorkRange
{
    uint itemOrdinal;
    uint itemCount;
    uint resultIndex;
    uint prefixBlockIndex;
};

struct GpuGeometryPrefixBlock
{
    uint requestedCount;
    uint rejectedCount;
    uint outputOffset;
    uint outputCapacity;
};

struct MeshDrawInstance
{
    uint instance;
    uint primitive;
    uint geometry;
    uint material;
};

struct GpuIndirectDrawIndexedArguments
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int baseVertex;
    uint firstInstance;
};

struct GpuGeometryPrefixConstants
{
    uint visibilityResultDescriptor;
    uint visibilityCounterDescriptor;
    uint itemDescriptor;
    uint resultDescriptor;
    uint counterDescriptor;
    uint expansionRangeDescriptor;
    uint binRangeDescriptor;
    uint binItemDescriptor;
    uint prefixBlockDescriptor;
    uint expansionRangeCount;
    uint binRangeCount;
    uint resultCount;
    uint layoutVersion;
    uint reserved0;
    uint reserved1;
    uint reserved2;
};

struct GpuGeometryBinningConstants
{
    uint workDescriptor;
    uint workRangeDescriptor;
    uint resultDescriptor;
    uint counterDescriptor;
    uint binItemDescriptor;
    uint instanceDescriptor;
    uint workRangeCount;
    uint resultCount;
    uint layoutVersion;
    uint reserved0;
    uint reserved1;
    uint reserved2;
};

struct GpuGeometryExpansionConstants
{
    uint tableDirectoryDescriptor;
    uint pageDirectoryDescriptor;
    uint visibleDescriptor;
    uint visibilityResultDescriptor;
    uint visibilityCounterDescriptor;
    uint workRangeDescriptor;
    uint itemDescriptor;
    uint workDescriptor;
    uint viewDescriptor;
    uint workRangeCount;
    uint layoutVersion;
    uint reserved0;
    uint reserved1;
    uint reserved2;
    uint reserved3;
    uint reserved4;
};

struct GpuGeometryShellRange
{
    uint shell;
    uint generation;
    uint resultIndex;
    uint phase;
    uint argumentOffset;
    uint argumentCapacity;
    uint counterIndex;
