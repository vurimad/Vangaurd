#include "gpu_scene_types.hlsli"

static const uint VG_GPU_VISIBILITY_THREADS = 128u;
static const uint VG_GPU_INSTANCE_ACTIVE = 1u << 0u;
static const uint VG_GPU_INSTANCE_FORCE_VISIBLE = 1u << 4u;
static const uint VG_GPU_PRIMITIVE_INDEXED = 1u << 0u;
static const uint VG_GPU_GEOMETRY_RESIDENT = 1u << 0u;
static const uint VG_GPU_GEOMETRY_INDEXED = 1u << 1u;
static const uint VG_GPU_VIEW_ORTHOGRAPHIC = 1u << 1u;
static const uint VG_GPU_VISIBILITY_CULLED = 0u;
static const uint VG_GPU_VISIBILITY_VISIBLE = 1u;
static const uint VG_GPU_VISIBILITY_REJECTED = 2u;
static const uint VG_GPU_VISIBILITY_REJECTED_PACK = 256u;

struct GpuVisibilityWorkRange
{
    uint candidateOffset;
    uint candidateCount;
    uint viewIndex;
    uint resultIndex;
};

struct GpuVisibilityResultRange
{
    uint visibleOffset;
    uint visibleCapacity;
    uint counterIndex;
    uint viewIndex;
};

struct GpuVisibilityCounters
{
    uint visibleCount;
    uint culledCount;
    uint overflowCount;
    uint rejectedCount;
};

struct GpuVisibleInstance
{
    uint instance;
    uint renderable;
    uint lod;
    uint placementRevision;
};

struct GpuVisibilityConstants
{
    uint tableDirectoryDescriptor;
    uint pageDirectoryDescriptor;
    uint viewDescriptor;
    uint resultRangeDescriptor;
    uint visibleDescriptor;
    uint counterDescriptor;
    uint sceneIndex;
    uint sceneGeneration;
    uint instanceTraversalExtent;
    uint viewCount;
    uint instanceTable;
    uint renderableTable;
    uint layoutVersion;
    float worldCellSize;
    uint reserved0;
    uint reserved1;
};

struct GpuGeometryWork
{
    uint instance;
    uint primitive;
    uint geometry;
    uint material;
    uint phase;
    uint shell;
    uint bin;
    uint binOrdinal;
};

struct GpuGeometryResultRange
{
    uint workOffset;
    uint workCapacity;
    uint binOffset;
    uint binCapacity;
    uint instanceOffset;
    uint instanceCapacity;
    uint argumentOffset;
    uint argumentCapacity;
    uint activeBinOffset;
    uint activeBinCapacity;
    uint reserved0;
    uint reserved1;
};

struct GpuGeometryCounters
{
    uint requestedWorkCount;
    uint emittedWorkCount;
    uint rejectedWorkCount;
    uint expansionOverflowCount;
    uint invalidBinWorkCount;
    uint instanceOverflowCount;
    uint visibleBinCount;
    uint rejectedIndirectBinCount;
};

struct GpuGeometryBinItem
{
    uint instanceCount;
    uint instanceCursor;
    uint instanceOffset;
    uint instanceCapacity;
};

struct MeshDrawInstance
{
    uint instance;
    uint primitive;
    uint geometry;
    uint material;
};

struct GpuIndirectDrawIndexedArguments
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int baseVertex;
    uint firstInstance;
};

struct GpuGeometryExpandConstants
{
    uint tableDirectoryDescriptor;
    uint pageDirectoryDescriptor;
    uint visibleDescriptor;
    uint visibilityResultDescriptor;
    uint visibilityCounterDescriptor;
    uint viewDescriptor;
    uint workDescriptor;
    uint resultDescriptor;
    uint counterDescriptor;
    uint binItemDescriptor;
    uint activeBinDescriptor;
    uint resultCount;
    uint visibleCapacityPerResult;
    uint layoutVersion;
    uint reserved0;
    uint reserved1;
};

struct GpuGeometryAllocateConstants
{
    uint tableDirectoryDescriptor;
    uint pageDirectoryDescriptor;
    uint resultDescriptor;
    uint counterDescriptor;
    uint binItemDescriptor;
    uint activeBinDescriptor;
    uint shellRangeDescriptor;
    uint shellCounterDescriptor;
    uint argumentDescriptor;
    uint resultCount;
    uint shellCapacity;
    uint shellPlanCount;
    uint layoutVersion;
    uint reserved0;
    uint reserved1;
    uint reserved2;
};

struct GpuGeometryScatterConstants
{
    uint workDescriptor;
    uint resultDescriptor;
    uint counterDescriptor;
    uint binItemDescriptor;
    uint instanceDescriptor;
    uint resultCount;
    uint workCapacityPerResult;
    uint layoutVersion;
};

struct GpuGeometryShellRange
{
    uint shell;
    uint generation;
    uint resultIndex;
    uint phase;
    uint argumentOffset;
    uint argumentCapacity;
    uint counterIndex;
    uint reserved;
};

struct GpuGeometryShellCounters
{
    uint drawCount;
    uint overflowCount;
    uint reserved0;
    uint reserved1;
};

struct GpuGeometryInitializeConstants
{
    uint shellPlanDescriptor;
    uint shellRangeDescriptor;
    uint shellCounterDescriptor;
    uint counterDescriptor;
    uint shellPlanCount;
    uint shellCapacity;
    uint resultCount;
    uint layoutVersion;
};

#if defined(VG_GPU_SCENE_VISIBILITY)
[[push_constant]] ConstantBuffer<GpuVisibilityConstants> constants;
#elif defined(VG_GPU_SCENE_SPARSE_EXPAND)
[[push_constant]] ConstantBuffer<GpuGeometryExpandConstants> expandConstants;
#elif defined(VG_GPU_SCENE_SPARSE_ALLOCATE)
[[push_constant]] ConstantBuffer<GpuGeometryAllocateConstants> allocateConstants;
#elif defined(VG_GPU_SCENE_SPARSE_SCATTER)
[[push_constant]] ConstantBuffer<GpuGeometryScatterConstants> scatterConstants;
#elif defined(VG_GPU_SCENE_INITIALIZE)
[[push_constant]] ConstantBuffer<GpuGeometryInitializeConstants> initializeConstants;
#else
#error gpu_scene_visibility requires one VG_GPU_SCENE_* feature-family define
#endif

groupshared uint groupVisibility[VG_GPU_VISIBILITY_THREADS];
groupshared uint groupOutputBase;
groupshared uint groupPrefix[VG_GPU_VISIBILITY_THREADS];
groupshared uint groupRejected[VG_GPU_VISIBILITY_THREADS];
groupshared uint groupChunkBase;

uint SaturatingAdd(uint left, uint right)
{
    uint result = left + right;
    return result < left ? 0xffffffffu : result;
}

bool ResolveGpuSceneAddress(uint index, uint tableIndex,
                            StructuredBuffer<GpuSceneTableDirectory> tables,
                            StructuredBuffer<GpuScenePageDirectoryEntry> pages,
                            out GpuScenePageDirectoryEntry page, out uint element)
{
    page = (GpuScenePageDirectoryEntry)0;
    element = 0u;
    if (index == VG_GPU_SCENE_INVALID_INDEX)
        return false;
    GpuSceneTableDirectory table = tables[tableIndex];
    uint2 address = DecodeGpuSceneIndex(index, table);
    if (address.x >= table.pageCapacity)
        return false;
    page = pages[table.firstPageEntry + address.x];
    element = address.y;
    return page.shaderResourceDescriptor != VG_GPU_SCENE_INVALID_INDEX && element < page.elementCount;
}

#define VG_DECLARE_GPU_SCENE_LOAD(Type, Name) \
Type Load##Name(GpuScenePageDirectoryEntry page, uint element) \
{ \
    StructuredBuffer<Type> values = ResourceDescriptorHeap[NonUniformResourceIndex(page.shaderResourceDescriptor)]; \
    return values[element]; \
}

VG_DECLARE_GPU_SCENE_LOAD(GpuInstance, GpuInstance)
VG_DECLARE_GPU_SCENE_LOAD(GpuRenderable, GpuRenderable)
VG_DECLARE_GPU_SCENE_LOAD(GpuRenderableResidency, GpuRenderableResidency)
VG_DECLARE_GPU_SCENE_LOAD(GpuLod, GpuLod)
VG_DECLARE_GPU_SCENE_LOAD(GpuPrimitive, GpuPrimitive)
VG_DECLARE_GPU_SCENE_LOAD(GpuPrimitivePlacement, GpuPrimitivePlacement)
VG_DECLARE_GPU_SCENE_LOAD(GpuPhaseParticipation, GpuPhaseParticipation)
VG_DECLARE_GPU_SCENE_LOAD(GpuPhasePlacement, GpuPhasePlacement)
VG_DECLARE_GPU_SCENE_LOAD(GpuGeometryRange, GpuGeometryRange)
VG_DECLARE_GPU_SCENE_LOAD(GpuGeometryShell, GpuGeometryShell)
VG_DECLARE_GPU_SCENE_LOAD(GpuGeometryBin, GpuGeometryBin)

bool IntersectsRequestedPhases(GpuRenderable renderable, GpuView view)
{
    return ((renderable.phaseMaskLow & view.phaseMaskLow) |
            (renderable.phaseMaskHigh & view.phaseMaskHigh)) != 0u;
}

bool RequestsPhase(uint phase, GpuView view)
{
    if (phase >= 64u)
        return false;
    uint bit = 1u << (phase & 31u);
    return phase < 32u ? (view.phaseMaskLow & bit) != 0u : (view.phaseMaskHigh & bit) != 0u;
}

bool IsLodResident(GpuRenderableResidency residency, uint lod)
{
    if (lod >= 64u)
        return false;
    uint bit = 1u << (lod & 31u);
    return lod < 32u ? (residency.residentLodMaskLow & bit) != 0u
                     : (residency.residentLodMaskHigh & bit) != 0u;
}

bool SphereIntersectsFrustum(float3 center, float radius, GpuView view)
{
    [loop]
    for (uint planeIndex = 0u; planeIndex < view.frustumPlaneCount; ++planeIndex)
    {
        GpuVisibilityPlane plane = view.frustum[planeIndex];
        if (dot(plane.normal, center) + plane.distance < -radius)
            return false;
    }
    return true;
}

float ProjectedScreenCoverage(float3 relativeCenter, float radius, GpuView view)
{
    float coverage = radius * abs(view.viewToClip[1].y);
    if ((view.flags & VG_GPU_VIEW_ORTHOGRAPHIC) == 0u)
    {
        float4 viewPosition = relativeCenter.x * view.worldToView[0] +
                              relativeCenter.y * view.worldToView[1] +
                              relativeCenter.z * view.worldToView[2] + view.worldToView[3];
        coverage /= max(abs(viewPosition.z), 1.0e-6f);
    }
    return coverage * exp2(-clamp(view.lodBias, -16.0f, 16.0f));
}

bool SelectResidentLod(GpuRenderable renderable, GpuRenderableResidency residency, float coverage,
                       StructuredBuffer<GpuSceneTableDirectory> tables,
                       StructuredBuffer<GpuScenePageDirectoryEntry> pages,
                       out uint selectedLod)
{
    selectedLod = VG_GPU_SCENE_INVALID_INDEX;
    if (renderable.lodCount == 0u || renderable.lodCount > 64u ||
        renderable.firstLod + renderable.lodCount < renderable.firstLod ||
        residency.anchorLod >= renderable.lodCount || !IsLodResident(residency, residency.anchorLod))
        return false;

    uint desired = renderable.lodCount - 1u;
    [loop]
    for (uint localLod = 0u; localLod < renderable.lodCount; ++localLod)
    {
        GpuScenePageDirectoryEntry page;
        uint element;
        if (!ResolveGpuSceneAddress(renderable.firstLod + localLod, VG_GPU_SCENE_TABLE_LOD,
                                    tables, pages, page, element))
            return false;
        if (coverage >= LoadGpuLod(page, element).minimumScreenCoverage)
        {
            desired = localLod;
            break;
        }
    }

    [loop]
    for (uint localLod = desired; localLod < renderable.lodCount; ++localLod)
    {
        if (IsLodResident(residency, localLod))
        {
            selectedLod = renderable.firstLod + localLod;
            return true;
        }
    }
    return false;
}

#if defined(VG_GPU_SCENE_VISIBILITY)
uint ResolveVisibleInstance(uint instanceIndex, GpuView view, uint sceneIndex, uint sceneGeneration,
                            StructuredBuffer<GpuSceneTableDirectory> tables,
                            StructuredBuffer<GpuScenePageDirectoryEntry> pages,
                            out GpuVisibleInstance visible)
{
    visible = (GpuVisibleInstance)0;
    GpuScenePageDirectoryEntry page;
    uint element;
    if (!ResolveGpuSceneAddress(instanceIndex, constants.instanceTable, tables, pages, page, element))
        return VG_GPU_VISIBILITY_REJECTED;
    GpuInstance instance = LoadGpuInstance(page, element);
    if ((instance.flags & VG_GPU_INSTANCE_ACTIVE) == 0u || instance.generation == 0u ||
        instance.sceneIndex != sceneIndex || instance.sceneGeneration != sceneGeneration ||
        instance.renderable == VG_GPU_SCENE_INVALID_INDEX)
        return VG_GPU_VISIBILITY_REJECTED;
    if ((instance.visibilityMask & view.visibilityMask) == 0u ||
        ((instance.layerMaskLow & view.layerMaskLow) == 0u &&
         (instance.layerMaskHigh & view.layerMaskHigh) == 0u))
        return VG_GPU_VISIBILITY_CULLED;
    if (!ResolveGpuSceneAddress(instance.renderable, constants.renderableTable, tables, pages, page, element))
        return VG_GPU_VISIBILITY_REJECTED;

    GpuRenderable renderable = LoadGpuRenderable(page, element);
    if (renderable.generation == 0u)
        return VG_GPU_VISIBILITY_REJECTED;
    if (!IntersectsRequestedPhases(renderable, view))
        return VG_GPU_VISIBILITY_CULLED;
    if (!ResolveGpuSceneAddress(instance.renderable, VG_GPU_SCENE_TABLE_RENDERABLE_RESIDENCY,
                                tables, pages, page, element))
        return VG_GPU_VISIBILITY_REJECTED;
    GpuRenderableResidency residency = LoadGpuRenderableResidency(page, element);
    if (residency.generation != renderable.generation || residency.placementRevision == 0u)
        return VG_GPU_VISIBILITY_REJECTED;

    float3 center = float3(instance.worldCell - view.worldCell) * constants.worldCellSize +
                    instance.localPosition - view.localPosition + instance.boundsCenterOffset;
    if ((instance.flags & VG_GPU_INSTANCE_FORCE_VISIBLE) == 0u &&
        !SphereIntersectsFrustum(center, instance.boundsRadius, view))
        return VG_GPU_VISIBILITY_CULLED;

    uint selectedLod;
    if (!SelectResidentLod(renderable, residency, ProjectedScreenCoverage(center, instance.boundsRadius, view),
                           tables, pages, selectedLod))
        return VG_GPU_VISIBILITY_REJECTED;
    visible.instance = instanceIndex;
    visible.renderable = instance.renderable;
    visible.lod = selectedLod;
    visible.placementRevision = residency.placementRevision;
    return VG_GPU_VISIBILITY_VISIBLE;
}
#endif

bool ResolveExpansionRoot(GpuVisibleInstance visible,
                          StructuredBuffer<GpuSceneTableDirectory> tables,
                          StructuredBuffer<GpuScenePageDirectoryEntry> pages,
                          out GpuInstance instance, out GpuLod lod)
{
    instance = (GpuInstance)0;
    lod = (GpuLod)0;
    GpuScenePageDirectoryEntry page;
    uint element;
    if (!ResolveGpuSceneAddress(visible.instance, VG_GPU_SCENE_TABLE_INSTANCE, tables, pages, page, element))
        return false;
    instance = LoadGpuInstance(page, element);
    if ((instance.flags & VG_GPU_INSTANCE_ACTIVE) == 0u || instance.generation == 0u ||
        instance.renderable != visible.renderable ||
        !ResolveGpuSceneAddress(visible.renderable, VG_GPU_SCENE_TABLE_RENDERABLE, tables, pages, page, element))
        return false;
    GpuRenderable renderable = LoadGpuRenderable(page, element);
    if (renderable.generation == 0u || visible.lod < renderable.firstLod ||
        visible.lod - renderable.firstLod >= renderable.lodCount ||
        !ResolveGpuSceneAddress(visible.renderable, VG_GPU_SCENE_TABLE_RENDERABLE_RESIDENCY,
                                tables, pages, page, element))
        return false;
    GpuRenderableResidency residency = LoadGpuRenderableResidency(page, element);
    uint localLod = visible.lod - renderable.firstLod;
    if (residency.generation != renderable.generation ||
        residency.placementRevision != visible.placementRevision ||
        !IsLodResident(residency, localLod) ||
        !ResolveGpuSceneAddress(visible.lod, VG_GPU_SCENE_TABLE_LOD, tables, pages, page, element))
        return false;
    lod = LoadGpuLod(page, element);
    return lod.firstPrimitive + lod.primitiveCount >= lod.firstPrimitive;
}

bool ResolveGeometryWork(GpuVisibleInstance visible, GpuInstance instance, GpuView view,
                         uint primitiveIndex, uint phaseIndex,
                         StructuredBuffer<GpuSceneTableDirectory> tables,
                         StructuredBuffer<GpuScenePageDirectoryEntry> pages,
                         out GpuGeometryWork work, out bool rejected)
{
    work = (GpuGeometryWork)0;
    rejected = true;
    GpuScenePageDirectoryEntry page;
    uint element;
    if (!ResolveGpuSceneAddress(primitiveIndex, VG_GPU_SCENE_TABLE_PRIMITIVE, tables, pages, page, element))
        return false;
    GpuPrimitive primitive = LoadGpuPrimitive(page, element);
    if ((primitive.flags & VG_GPU_PRIMITIVE_INDEXED) == 0u ||
        primitive.material == VG_GPU_SCENE_INVALID_INDEX ||
        !ResolveGpuSceneAddress(primitiveIndex, VG_GPU_SCENE_TABLE_PRIMITIVE_PLACEMENT,
                                tables, pages, page, element))
        return false;
    GpuPrimitivePlacement primitivePlacement = LoadGpuPrimitivePlacement(page, element);
    if (primitivePlacement.placementRevision != visible.placementRevision ||
        primitivePlacement.geometryGeneration == 0u ||
        !ResolveGpuSceneAddress(phaseIndex, VG_GPU_SCENE_TABLE_PHASE_PARTICIPATION,
                                tables, pages, page, element))
        return false;
    GpuPhaseParticipation participation = LoadGpuPhaseParticipation(page, element);
    if (!RequestsPhase(participation.phase, view))
    {
        rejected = false;
        return false;
    }
    if (!ResolveGpuSceneAddress(phaseIndex, VG_GPU_SCENE_TABLE_PHASE_PLACEMENT,
                                tables, pages, page, element))
        return false;
    GpuPhasePlacement phasePlacement = LoadGpuPhasePlacement(page, element);
    if (phasePlacement.placementRevision != visible.placementRevision)
        return false;

    bool mirrored = (instance.flags & VG_GPU_INSTANCE_NEGATIVE_SCALE) != 0u;
    uint shellIndex = mirrored ? phasePlacement.mirroredShell : phasePlacement.normalShell;
    uint shellGeneration = mirrored ? phasePlacement.mirroredShellGeneration : phasePlacement.normalShellGeneration;
    uint binIndex = mirrored ? phasePlacement.mirroredBin : phasePlacement.normalBin;
    uint binGeneration = mirrored ? phasePlacement.mirroredBinGeneration : phasePlacement.normalBinGeneration;
    if (shellGeneration == 0u || binGeneration == 0u ||
        !ResolveGpuSceneAddress(primitivePlacement.geometry, VG_GPU_SCENE_TABLE_GEOMETRY_RANGE,
                                tables, pages, page, element))
        return false;
    GpuGeometryRange geometry = LoadGpuGeometryRange(page, element);
    if (geometry.generation != primitivePlacement.geometryGeneration ||
        (geometry.flags & (VG_GPU_GEOMETRY_RESIDENT | VG_GPU_GEOMETRY_INDEXED)) !=
            (VG_GPU_GEOMETRY_RESIDENT | VG_GPU_GEOMETRY_INDEXED) ||
        !ResolveGpuSceneAddress(shellIndex, VG_GPU_SCENE_TABLE_GEOMETRY_SHELL,
                                tables, pages, page, element))
        return false;
    GpuGeometryShell shell = LoadGpuGeometryShell(page, element);
    if (shell.generation != shellGeneration ||
        (shell.flags & VG_GPU_GEOMETRY_CATALOG_ACTIVE) == 0u ||
        shell.phase != participation.phase || shell.vertexArena != geometry.vertexArenaSet ||
        shell.vertexArenaGeneration != geometry.vertexArenaGeneration ||
        shell.indexArena != geometry.indexArena ||
        shell.indexArenaGeneration != geometry.indexArenaGeneration ||
        !ResolveGpuSceneAddress(binIndex, VG_GPU_SCENE_TABLE_GEOMETRY_BIN,
                                tables, pages, page, element))
        return false;
    GpuGeometryBin bin = LoadGpuGeometryBin(page, element);
    if (bin.generation != binGeneration ||
        (bin.flags & VG_GPU_GEOMETRY_CATALOG_ACTIVE) == 0u ||
        bin.shell != shellIndex || bin.shellGeneration != shellGeneration ||
        bin.shellOrdinal >= shell.binCount ||
        bin.geometry != primitivePlacement.geometry ||
        bin.geometryGeneration != primitivePlacement.geometryGeneration ||
        bin.firstIndex != geometry.firstIndex || bin.indexCount != geometry.indexCount ||
        geometry.baseVertex < 0 || bin.firstVertex != uint(geometry.baseVertex) ||
        bin.vertexCount != geometry.vertexCount)
        return false;

    work.instance = visible.instance;
    work.primitive = primitiveIndex;
    work.geometry = primitivePlacement.geometry;
    work.material = primitive.material;
    work.phase = participation.phase;
    work.shell = shellIndex;
    work.bin = binIndex;
    work.binOrdinal = VG_GPU_SCENE_INVALID_INDEX;
    return true;
}

#if defined(VG_GPU_SCENE_VISIBILITY)
[shader("compute")]
[numthreads(VG_GPU_VISIBILITY_THREADS, 1, 1)]
void CullGpuSceneInstances(uint3 groupId : SV_GroupID, uint threadIndex : SV_GroupIndex)
{
    if (constants.layoutVersion != VG_GPU_SCENE_LAYOUT_VERSION || groupId.y >= constants.viewCount)
        return;
    uint firstInstance = groupId.x * VG_GPU_VISIBILITY_THREADS;
    if (firstInstance >= constants.instanceTraversalExtent)
        return;
    StructuredBuffer<GpuSceneTableDirectory> tables = ResourceDescriptorHeap[constants.tableDirectoryDescriptor];
    StructuredBuffer<GpuScenePageDirectoryEntry> pages = ResourceDescriptorHeap[constants.pageDirectoryDescriptor];
    StructuredBuffer<GpuView> views = ResourceDescriptorHeap[constants.viewDescriptor];
    StructuredBuffer<GpuVisibilityResultRange> results = ResourceDescriptorHeap[constants.resultRangeDescriptor];
    RWStructuredBuffer<GpuVisibleInstance> visibleInstances = ResourceDescriptorHeap[constants.visibleDescriptor];
    RWStructuredBuffer<GpuVisibilityCounters> counters = ResourceDescriptorHeap[constants.counterDescriptor];

    uint viewIndex = groupId.y;
    GpuVisibilityResultRange result = results[viewIndex];
    if (result.viewIndex != viewIndex)
        return;
    GpuView view = views[viewIndex];
    uint candidateCount = min(VG_GPU_VISIBILITY_THREADS, constants.instanceTraversalExtent - firstInstance);
    bool participates = threadIndex < candidateCount;
    uint instanceIndex = participates ? firstInstance + threadIndex : VG_GPU_SCENE_INVALID_INDEX;
    GpuVisibleInstance visible = (GpuVisibleInstance)0;
    uint visibility = participates ? ResolveVisibleInstance(instanceIndex, view, constants.sceneIndex, constants.sceneGeneration,
                                                            tables, pages, visible)
                                   : VG_GPU_VISIBILITY_CULLED;
    bool isVisible = visibility == VG_GPU_VISIBILITY_VISIBLE;
    groupVisibility[threadIndex] = isVisible ? 1u :
                                   (visibility == VG_GPU_VISIBILITY_REJECTED ? VG_GPU_VISIBILITY_REJECTED_PACK : 0u);
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint offset = 1u; offset < VG_GPU_VISIBILITY_THREADS; offset <<= 1u)
    {
        uint preceding = threadIndex >= offset ? groupVisibility[threadIndex - offset] : 0u;
        GroupMemoryBarrierWithGroupSync();
        groupVisibility[threadIndex] += preceding;
        GroupMemoryBarrierWithGroupSync();
    }

    uint packedGroupCounts = groupVisibility[VG_GPU_VISIBILITY_THREADS - 1u];
    uint groupVisibleCount = packedGroupCounts & 0xffu;
    uint groupRejectedCount = packedGroupCounts >> 8u;
    if (threadIndex == 0u)
    {
        // At most one nonzero update per counter per 128-candidate group.
        // Empty groups do not need a reservation or an atomic read of the base.
        groupOutputBase = 0u;
        if (groupVisibleCount != 0u)
            InterlockedAdd(counters[result.counterIndex].visibleCount, groupVisibleCount, groupOutputBase);
        uint groupCulledCount = candidateCount - groupVisibleCount - groupRejectedCount;
        if (groupCulledCount != 0u)
            InterlockedAdd(counters[result.counterIndex].culledCount, groupCulledCount);
        if (groupRejectedCount != 0u)
            InterlockedAdd(counters[result.counterIndex].rejectedCount, groupRejectedCount);
        uint writable = groupOutputBase < result.visibleCapacity
                            ? min(groupVisibleCount, result.visibleCapacity - groupOutputBase) : 0u;
        if (writable != groupVisibleCount)
            InterlockedAdd(counters[result.counterIndex].overflowCount, groupVisibleCount - writable);
    }
    GroupMemoryBarrierWithGroupSync();

    if (isVisible)
    {
        uint destination = groupOutputBase + (groupVisibility[threadIndex] & 0xffu) - 1u;
        if (destination < result.visibleCapacity)
            visibleInstances[result.visibleOffset + destination] = visible;
    }
}
#endif

#if defined(VG_GPU_SCENE_SPARSE_EXPAND)
[shader("compute")]
[numthreads(VG_GPU_VISIBILITY_THREADS, 1, 1)]
void ExpandAppendGpuSceneGeometry(uint3 groupId : SV_GroupID, uint threadIndex : SV_GroupIndex)
{
    if (expandConstants.layoutVersion != VG_GPU_SCENE_LAYOUT_VERSION || expandConstants.resultCount == 0u ||
        expandConstants.visibleCapacityPerResult == 0u)
        return;
    uint globalOrdinal = groupId.x * VG_GPU_VISIBILITY_THREADS + threadIndex;
    uint resultIndex = globalOrdinal / expandConstants.visibleCapacityPerResult;
    if (resultIndex >= expandConstants.resultCount)
        return;
    uint visibleOrdinal = globalOrdinal - resultIndex * expandConstants.visibleCapacityPerResult;

    StructuredBuffer<GpuSceneTableDirectory> tables = ResourceDescriptorHeap[expandConstants.tableDirectoryDescriptor];
    StructuredBuffer<GpuScenePageDirectoryEntry> pages = ResourceDescriptorHeap[expandConstants.pageDirectoryDescriptor];
    StructuredBuffer<GpuVisibleInstance> visibleInstances = ResourceDescriptorHeap[expandConstants.visibleDescriptor];
    StructuredBuffer<GpuVisibilityResultRange> visibilityResults = ResourceDescriptorHeap[expandConstants.visibilityResultDescriptor];
    StructuredBuffer<GpuVisibilityCounters> visibilityCounters = ResourceDescriptorHeap[expandConstants.visibilityCounterDescriptor];
    StructuredBuffer<GpuView> views = ResourceDescriptorHeap[expandConstants.viewDescriptor];
    StructuredBuffer<GpuGeometryResultRange> results = ResourceDescriptorHeap[expandConstants.resultDescriptor];
    RWStructuredBuffer<GpuGeometryWork> output = ResourceDescriptorHeap[expandConstants.workDescriptor];
    RWStructuredBuffer<GpuGeometryCounters> geometryCounters = ResourceDescriptorHeap[expandConstants.counterDescriptor];
    RWStructuredBuffer<GpuGeometryBinItem> bins = ResourceDescriptorHeap[expandConstants.binItemDescriptor];
    RWStructuredBuffer<uint> activeBins = ResourceDescriptorHeap[expandConstants.activeBinDescriptor];

    GpuVisibilityResultRange visibility = visibilityResults[resultIndex];
    GpuGeometryResultRange result = results[resultIndex];
    if (visibility.viewIndex != resultIndex || visibility.visibleCapacity != expandConstants.visibleCapacityPerResult)
        return;
    uint visibleCount = min(visibilityCounters[visibility.counterIndex].visibleCount, visibility.visibleCapacity);
    if (visibleOrdinal >= visibleCount)
        return;
    GpuVisibleInstance visible = visibleInstances[visibility.visibleOffset + visibleOrdinal];
    GpuInstance instance;
    GpuLod lod;
    uint rejectedCount = 0u;
    if (!ResolveExpansionRoot(visible, tables, pages, instance, lod))
        rejectedCount = 1u;
    else
    {
        [loop]
        for (uint primitiveOffset = 0u; primitiveOffset < lod.primitiveCount; ++primitiveOffset)
        {
            uint primitiveIndex = lod.firstPrimitive + primitiveOffset;
            GpuScenePageDirectoryEntry page;
            uint element;
            if (!ResolveGpuSceneAddress(primitiveIndex, VG_GPU_SCENE_TABLE_PRIMITIVE, tables, pages, page, element))
            {
                ++rejectedCount;
                continue;
            }
            GpuPrimitive primitive = LoadGpuPrimitive(page, element);
            if (primitive.firstPhaseParticipation + primitive.phaseParticipationCount < primitive.firstPhaseParticipation)
            {
                ++rejectedCount;
                continue;
            }
            [loop]
            for (uint phaseOffset = 0u; phaseOffset < primitive.phaseParticipationCount; ++phaseOffset)
            {
                GpuGeometryWork work;
                bool rejected;
                if (!ResolveGeometryWork(visible, instance, views[visibility.viewIndex], primitiveIndex,
                                         primitive.firstPhaseParticipation + phaseOffset, tables, pages, work, rejected))
                {
                    if (rejected)
                        ++rejectedCount;
                    continue;
                }

                uint workOrdinal = 0u;
                InterlockedAdd(geometryCounters[resultIndex].requestedWorkCount, 1u, workOrdinal);
                if (workOrdinal >= result.workCapacity)
                    continue;
                if (work.bin >= result.binCapacity)
                {
                    InterlockedAdd(geometryCounters[resultIndex].invalidBinWorkCount, 1u);
                    work.binOrdinal = VG_GPU_SCENE_INVALID_INDEX;
                    output[result.workOffset + workOrdinal] = work;
                    continue;
                }

                uint frameBin = result.binOffset + work.bin;
                uint binOrdinal = 0u;
                InterlockedAdd(bins[frameBin].instanceCount, 1u, binOrdinal);
                work.binOrdinal = binOrdinal;
                if (binOrdinal == 0u)
                {
                    uint activeOrdinal = 0u;
                    InterlockedAdd(geometryCounters[resultIndex].visibleBinCount, 1u, activeOrdinal);
                    if (activeOrdinal < result.activeBinCapacity)
                        activeBins[result.activeBinOffset + activeOrdinal] = work.bin;
                }
                output[result.workOffset + workOrdinal] = work;
            }
        }
    }
    if (rejectedCount != 0u)
        InterlockedAdd(geometryCounters[resultIndex].rejectedWorkCount, rejectedCount);
}
#endif

#if defined(VG_GPU_SCENE_SPARSE_ALLOCATE)
bool ResolveSparseIndirectShellRange(uint binIndex, uint resultIndex, GpuGeometryResultRange result,
                                    out GpuGeometryBin bin, out GpuGeometryShellRange shellRange)
{
    bin = (GpuGeometryBin)0;
    shellRange = (GpuGeometryShellRange)0;
    StructuredBuffer<GpuSceneTableDirectory> tables = ResourceDescriptorHeap[allocateConstants.tableDirectoryDescriptor];
    StructuredBuffer<GpuScenePageDirectoryEntry> pages = ResourceDescriptorHeap[allocateConstants.pageDirectoryDescriptor];
    StructuredBuffer<GpuGeometryShellRange> shellRanges = ResourceDescriptorHeap[allocateConstants.shellRangeDescriptor];
    GpuScenePageDirectoryEntry page;
    uint element;
    if (!ResolveGpuSceneAddress(binIndex, VG_GPU_SCENE_TABLE_GEOMETRY_BIN, tables, pages, page, element))
        return false;
    bin = LoadGpuGeometryBin(page, element);
    if ((bin.flags & VG_GPU_GEOMETRY_CATALOG_ACTIVE) == 0u || bin.generation == 0u ||
        bin.indexCount == 0u || bin.firstVertex > 0x7fffffffu || bin.shell >= allocateConstants.shellCapacity ||
        !ResolveGpuSceneAddress(bin.shell, VG_GPU_SCENE_TABLE_GEOMETRY_SHELL, tables, pages, page, element))
        return false;
    GpuGeometryShell shell = LoadGpuGeometryShell(page, element);
    shellRange = shellRanges[resultIndex * allocateConstants.shellCapacity + bin.shell];
    if ((shell.flags & VG_GPU_GEOMETRY_CATALOG_ACTIVE) == 0u || shell.generation == 0u ||
        shell.generation != bin.shellGeneration || shellRange.generation != shell.generation ||
        shellRange.shell != bin.shell || shellRange.resultIndex != resultIndex || shellRange.phase != shell.phase ||
        shellRange.argumentCapacity != shell.binCount || bin.shellOrdinal >= shell.binCount ||
        shellRange.counterIndex >= allocateConstants.shellPlanCount || shellRange.argumentOffset < result.argumentOffset)
        return false;
    uint relativeOffset = shellRange.argumentOffset - result.argumentOffset;
    return relativeOffset <= result.argumentCapacity && shellRange.argumentCapacity <= result.argumentCapacity - relativeOffset;
}

[shader("compute")]
[numthreads(VG_GPU_VISIBILITY_THREADS, 1, 1)]
void AllocateGpuSceneGeometryBins(uint3 groupId : SV_GroupID, uint threadIndex : SV_GroupIndex)
{
    if (allocateConstants.layoutVersion != VG_GPU_SCENE_LAYOUT_VERSION || groupId.x >= allocateConstants.resultCount)
        return;
    StructuredBuffer<GpuGeometryResultRange> results = ResourceDescriptorHeap[allocateConstants.resultDescriptor];
    RWStructuredBuffer<GpuGeometryCounters> counters = ResourceDescriptorHeap[allocateConstants.counterDescriptor];
    RWStructuredBuffer<GpuGeometryBinItem> bins = ResourceDescriptorHeap[allocateConstants.binItemDescriptor];
    StructuredBuffer<uint> activeBins = ResourceDescriptorHeap[allocateConstants.activeBinDescriptor];
    RWStructuredBuffer<GpuGeometryShellCounters> shellCounters = ResourceDescriptorHeap[allocateConstants.shellCounterDescriptor];
    RWStructuredBuffer<GpuIndirectDrawIndexedArguments> arguments = ResourceDescriptorHeap[allocateConstants.argumentDescriptor];

    uint resultIndex = groupId.x;
    GpuGeometryResultRange result = results[resultIndex];
    uint activeCount = min(counters[resultIndex].visibleBinCount, result.activeBinCapacity);
    if (threadIndex == 0u)
        groupChunkBase = 0u;
    GroupMemoryBarrierWithGroupSync();

    for (uint chunk = 0u; chunk < activeCount; chunk += VG_GPU_VISIBILITY_THREADS)
    {
        uint activeOrdinal = chunk + threadIndex;
        uint localBin = activeOrdinal < activeCount ? activeBins[result.activeBinOffset + activeOrdinal] : VG_GPU_SCENE_INVALID_INDEX;
        bool validBin = localBin < result.binCapacity;
        uint frameBin = validBin ? result.binOffset + localBin : 0u;
        GpuGeometryBinItem item = validBin ? bins[frameBin] : (GpuGeometryBinItem)0;
        uint requested = validBin ? item.instanceCount : 0u;

        groupPrefix[threadIndex] = requested;
        GroupMemoryBarrierWithGroupSync();
        [unroll]
        for (uint offset = 1u; offset < VG_GPU_VISIBILITY_THREADS; offset <<= 1u)
        {
            uint preceding = threadIndex >= offset ? groupPrefix[threadIndex - offset] : 0u;
            GroupMemoryBarrierWithGroupSync();
            groupPrefix[threadIndex] = SaturatingAdd(groupPrefix[threadIndex], preceding);
            GroupMemoryBarrierWithGroupSync();
        }

        uint chunkBase = groupChunkBase;
        if (validBin)
        {
            uint localOffset = groupPrefix[threadIndex] - requested;
            uint requestedOffset = SaturatingAdd(chunkBase, localOffset);
            item.instanceCursor = 0u;
            item.instanceOffset = result.instanceOffset + min(requestedOffset, result.instanceCapacity);
            item.instanceCapacity = requestedOffset < result.instanceCapacity
                                      ? min(requested, result.instanceCapacity - requestedOffset) : 0u;
            bins[frameBin] = item;

            if (item.instanceCapacity != 0u)
            {
                GpuGeometryBin bin;
                GpuGeometryShellRange shellRange;
                bool valid = ResolveSparseIndirectShellRange(localBin, resultIndex, result, bin, shellRange);
                valid = valid && item.instanceOffset >= result.instanceOffset;
                uint relativeInstance = item.instanceOffset - result.instanceOffset;
                valid = valid && relativeInstance <= result.instanceCapacity &&
                        item.instanceCapacity <= result.instanceCapacity - relativeInstance;
                if (!valid)
                    InterlockedAdd(counters[resultIndex].rejectedIndirectBinCount, 1u);
                else
                {
                    uint argumentOrdinal = 0u;
                    InterlockedAdd(shellCounters[shellRange.counterIndex].drawCount, 1u, argumentOrdinal);
                    if (argumentOrdinal >= shellRange.argumentCapacity)
                        InterlockedAdd(shellCounters[shellRange.counterIndex].overflowCount, 1u);
                    else
                    {
                        GpuIndirectDrawIndexedArguments argument;
                        argument.indexCount = bin.indexCount;
                        argument.instanceCount = item.instanceCapacity;
                        argument.firstIndex = bin.firstIndex;
                        argument.baseVertex = int(bin.firstVertex);
                        argument.firstInstance = item.instanceOffset;
                        arguments[shellRange.argumentOffset + argumentOrdinal] = argument;
                    }
                }
            }
        }

        GroupMemoryBarrierWithGroupSync();
        if (threadIndex == 0u)
            groupChunkBase = SaturatingAdd(groupChunkBase, groupPrefix[VG_GPU_VISIBILITY_THREADS - 1u]);
        GroupMemoryBarrierWithGroupSync();
    }

    if (threadIndex == 0u)
    {
        uint requestedWork = counters[resultIndex].requestedWorkCount;
        uint emittedWork = min(requestedWork, result.workCapacity);
        counters[resultIndex].emittedWorkCount = emittedWork;
        counters[resultIndex].expansionOverflowCount = requestedWork - emittedWork;
        uint requestedInstances = groupChunkBase;
        counters[resultIndex].instanceOverflowCount = requestedInstances - min(requestedInstances, result.instanceCapacity);
    }
}
#endif

#if defined(VG_GPU_SCENE_SPARSE_SCATTER)
[shader("compute")]
[numthreads(VG_GPU_VISIBILITY_THREADS, 1, 1)]
void ScatterGpuSceneGeometryInstances(uint3 groupId : SV_GroupID, uint threadIndex : SV_GroupIndex)
{
    if (scatterConstants.layoutVersion != VG_GPU_SCENE_LAYOUT_VERSION || scatterConstants.resultCount == 0u ||
        scatterConstants.workCapacityPerResult == 0u)
        return;
    uint globalOrdinal = groupId.x * VG_GPU_VISIBILITY_THREADS + threadIndex;
    uint resultIndex = globalOrdinal / scatterConstants.workCapacityPerResult;
    if (resultIndex >= scatterConstants.resultCount)
        return;
    uint ordinal = globalOrdinal - resultIndex * scatterConstants.workCapacityPerResult;

    StructuredBuffer<GpuGeometryWork> workItems = ResourceDescriptorHeap[scatterConstants.workDescriptor];
    StructuredBuffer<GpuGeometryResultRange> results = ResourceDescriptorHeap[scatterConstants.resultDescriptor];
    StructuredBuffer<GpuGeometryCounters> counters = ResourceDescriptorHeap[scatterConstants.counterDescriptor];
    StructuredBuffer<GpuGeometryBinItem> bins = ResourceDescriptorHeap[scatterConstants.binItemDescriptor];
    RWStructuredBuffer<MeshDrawInstance> instances = ResourceDescriptorHeap[scatterConstants.instanceDescriptor];
    GpuGeometryResultRange result = results[resultIndex];
    uint emittedCount = min(counters[resultIndex].emittedWorkCount, result.workCapacity);
    if (ordinal >= emittedCount)
        return;
    GpuGeometryWork work = workItems[result.workOffset + ordinal];
    if (work.bin >= result.binCapacity || work.binOrdinal == VG_GPU_SCENE_INVALID_INDEX)
        return;
    GpuGeometryBinItem item = bins[result.binOffset + work.bin];
    if (work.binOrdinal >= item.instanceCapacity)
        return;
    instances[item.instanceOffset + work.binOrdinal] = {work.instance, work.primitive, work.geometry, work.material};
}
#endif

#if defined(VG_GPU_SCENE_INITIALIZE)
[shader("compute")]
[numthreads(VG_GPU_VISIBILITY_THREADS, 1, 1)]
void InitializeGpuSceneGeometryShellRanges(uint3 dispatchId : SV_DispatchThreadID)
{
    if (initializeConstants.layoutVersion != VG_GPU_SCENE_LAYOUT_VERSION)
        return;
    if (dispatchId.x < initializeConstants.resultCount)
    {
        RWStructuredBuffer<GpuGeometryCounters> geometryCounters = ResourceDescriptorHeap[initializeConstants.counterDescriptor];
        geometryCounters[dispatchId.x] = (GpuGeometryCounters)0;
    }
    if (dispatchId.x >= initializeConstants.shellPlanCount)
        return;
    StructuredBuffer<GpuGeometryShellRange> plans = ResourceDescriptorHeap[initializeConstants.shellPlanDescriptor];
    RWStructuredBuffer<GpuGeometryShellRange> ranges = ResourceDescriptorHeap[initializeConstants.shellRangeDescriptor];
    RWStructuredBuffer<GpuGeometryShellCounters> counters = ResourceDescriptorHeap[initializeConstants.shellCounterDescriptor];
    // Unique writer per dense plan. The graph clears the direct range table
    // (generation zero means unmapped) before this dispatch, then orders both
    // outputs before argument generation. No atomic initialization is needed.
    counters[dispatchId.x] = (GpuGeometryShellCounters)0;
    GpuGeometryShellRange plan = plans[dispatchId.x];
    if (plan.generation == 0u || plan.shell >= initializeConstants.shellCapacity ||
        plan.resultIndex >= initializeConstants.resultCount || plan.counterIndex != dispatchId.x)
        return;
    ranges[plan.resultIndex * initializeConstants.shellCapacity + plan.shell] = plan;
}
#endif
