Bool SRenderNodeImplContext::IsConsumePhase() const
{
	return m_isConsumePhase;
}

const CRenderFrameInfo& SRenderNodeImplContext::GetFrameInfo() const
{
	RED_FATAL_ASSERT( m_frame, "" );
	return m_frame->GetFrameInfo();
}

CRenderSceneEx* SRenderNodeImplContext::GetScene() const
{
	return static_cast< CRenderSceneEx* >( GetFrameInfo().GetScene() );
}

void SRenderNodeImplContext::SetupNodeData( const SRenderNodeContext &nodeContext, const SRenderNodeParameters &nodeParams )
{
	m_renderFlowSpace	= 0xFF;
	m_renderFlowGroup	= nodeContext.m_renderFlowGroups[RNDT_Gpu];
	m_isNodeUnique		= RNT_Unique == nodeParams.m_type;
	m_isConsumePhase	= GetResourceAllocator()->IsConsumePhase();

	if ( !m_isNodeUnique && m_cameraStorage && m_cameraStorage->HasAnyCamera() )
	{
		const CRenderFrameCameraStorage::SCameraData *cameraData = m_cameraStorage->GetCameraData(nodeContext.m_cameraIndex);
		m_renderFlowSpace			= cameraData->m_renderFlowSpace;
		m_visViewId					= cameraData->m_renderFlowSpace + 1; // VIS_HACK: Just use i+1 as vis::ViewID. This leaves 0 available for non-view-based queries (such as dyndecals).
		m_cameraData				= cameraData;
		RED_ASSERT(m_visViewId > 0);
	}
	else
	{
		m_cameraData	= nullptr;
		m_visViewId		= 0;
	}
}

void SRenderNodeImplContext::ResetNodeData()
{
	m_renderFlowGroup	= std::numeric_limits<TRenderFlowGroup>::max();
	m_renderFlowSpace	= 0xff; // 8 bit, setting max value properly
	m_isNodeUnique		= false;
	m_cameraData		= nullptr;
	m_visViewId			= 0;

	BeginNewNode();
}

void SRenderNodeImplContext::BeginNewNode() const
{
	m_texturesToUnbind	= 0;
	m_srvToUnbind		= 0;
	m_uavToUnbind		= 0;
	m_usedStages		= 0;
	m_psoBound			= 0;
}

void SRenderNodeImplContext::Init( const SInitData &initData )
{
	RED_FATAL_ASSERT( initData.m_frame, "" );
	RED_FATAL_ASSERT( initData.m_dispatcherThreadIndex != -1, "Uninitialized dispatcherThreadIndex in SInitData" );
	
	m_frame					= initData.m_frame;
	m_resAlloc				= initData.m_resAlloc;
	m_cameraIndex			= initData.m_cameraIndex;
	m_dispatcherThreadIndex	= initData.m_dispatcherThreadIndex;

	m_cameraData			= nullptr;
	m_cameraStorage			= nullptr;
	m_maxCameraRenderWidth	= 0;
	m_maxCameraRenderHeight = 0;

	if ( !initData.m_skipCameraData )
	{
		if ( CRenderSceneEx *scene = static_cast<CRenderSceneEx*>(initData.m_frame->GetFrameInfo().GetScene()) )
		{
			m_cameraStorage = scene->GetCameraStorage();
			RED_FATAL_ASSERT( m_cameraStorage, "Expected camera storage in every scene" );
		}
		if ( m_cameraStorage )
		{
			Uint32 width = 0, height = 0;
			{
				m_cameraStorage->GetMaxActiveCameraRenderSize( true, true, width, height );
			}
			m_maxCameraRenderWidth	= width;
			m_maxCameraRenderHeight	= height;
		}
	}

	ResetNodeData();
}

SRenderNodeImplContext::SRenderNodeImplContext()
	: m_renderFlowGroup( std::numeric_limits<TRenderFlowGroup>::max() )
	, m_renderFlowSpace( 0xff )  // 8 bit, setting max value properly
	, m_isNodeUnique( false )
	, m_visViewId( 0 )
	, m_cameraData( nullptr )
	, m_cameraStorage( nullptr )
	, m_maxCameraRenderWidth( 0 )
	, m_maxCameraRenderHeight( 0 )
{
	ResetNodeData();
}

SRenderNodeImplContext::SRenderNodeImplContext( const SRenderNodeImplContext& other, Uint32 dispatcherThreadIndex )
	: SRenderNodeImplContext( other )
{
	m_dispatcherThreadIndex = dispatcherThreadIndex;
}

SRenderNodeImplContext::~SRenderNodeImplContext()
{
}

