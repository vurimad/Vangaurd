#pragma once


//********************************************************************************//
//********************************************************************************//

template< typename T, Uint32 IdTypeMask >
class TRenderNodeGraphArray
{
	struct DataWrapper
	{
		DataWrapper ()
			: m_usageIndex( -1 )
		{}

		Int32 m_usageIndex;
		T m_data;
	};

public:
	RED_FORCE_INLINE static Bool IsValidId( Uint32 id )
	{
		return 0 != (id & IdTypeMask);
	}

	RED_FORCE_INLINE static Uint32 IdToIndex( Uint32 id )
	{
		RED_ASSERT( IsValidId( id ) );
		return id & ~IdTypeMask;
	}

	RED_FORCE_INLINE static Uint32 IndexToId( Uint32 index )
	{
		const Uint32 id = index | IdTypeMask;
		RED_ASSERT( id != index );
		return id;
	}

	TRenderNodeGraphArray( Uint32 capacityStart, Uint32 capacityGrow )
		: m_capacityStart( capacityStart )
		, m_capacityGrow( capacityGrow )
		, m_numUsed( 0 )
	{
		m_items.Reserve( capacityStart );
		m_usage.Reserve( capacityStart );
	}

	Bool IsAllocated( Uint32 id ) const
	{		
		Uint32 index = IdToIndex( id );
		return index < m_items.Size() && -1 != m_items[index].m_usageIndex;
	}

	/// Allocated item will be placed at the end of used items. 
	/** It's index (don't confuse with ID) equals numItems from before allocation, the order of other items will not be changed.
		Some algorithms in renderNodeGraph may depend on this behavior since it allows for easy reindexing of nodes addes from other graph.
	*/
	Uint32 Allocate()
	{
		Uint32 resultItemIndex = 0xffffffff;
		
		if ( m_numUsed < m_usage.Size() )
		{
			const Uint32 newItemIndex = m_usage[m_numUsed];
			const Uint32 newUsageIndex = m_numUsed;
			RED_ASSERT( -1 == m_items[newItemIndex].m_usageIndex );
			m_items[newItemIndex].m_usageIndex = (Int32)newUsageIndex;
			++m_numUsed;

			resultItemIndex = newItemIndex;
		}
		else
		{
			if ( m_items.Size() == m_items.Capacity() )
				m_items.Reserve( m_items.Size() + m_capacityGrow );
			if ( m_usage.Size() == m_usage.Capacity() )
				m_usage.Reserve( m_usage.Size() + m_capacityGrow );

			RED_ASSERT( m_usage.Size() == m_items.Size() );
			const Uint32 newItemIndex = m_items.Size();
			const Int32 newUsageIndex = (Int32)newItemIndex;
			m_items.Grow( 1 );
			m_items[newItemIndex].m_usageIndex = newUsageIndex;
			m_usage.PushBack( newItemIndex );
			++m_numUsed;

			resultItemIndex = newItemIndex;
		}

		RED_ASSERT( resultItemIndex < m_items.Size() );
		RED_ASSERT( -1 != m_items[resultItemIndex].m_usageIndex );
		RED_ASSERT( m_usage[ m_items[resultItemIndex].m_usageIndex ] == resultItemIndex );

		return IndexToId( resultItemIndex );
	}

	/// Allocates given number of items
	/** It behaves the same as if succeeding items would be allocated one by one with regular Allocate(), so
	    user is able to access their it's by getting ID's of tail items.
	*/
	void Allocate( Uint32 numItems )
	{
		// TODO: optimize
		for ( Uint32 i=0; i<numItems; ++i )
		{
			Allocate();
		}
	}

	/// Freeing and index may change the order of other items
	void Free( Uint32 id )
	{
		RED_ASSERT( IsAllocated( id ) );

		const Uint32 itemToFreeIndex = IdToIndex( id );
		const Uint32 itemAtBackIndex = m_usage[m_numUsed - 1];
		DataWrapper &itemToFree = m_items[itemToFreeIndex];
		DataWrapper &itemAtBack = m_items[itemAtBackIndex];
		RED_ASSERT( itemToFree.m_usageIndex < (Int32)m_numUsed );
		RED_ASSERT( itemAtBack.m_usageIndex < (Int32)m_numUsed );
		RED_ASSERT( m_usage[itemToFree.m_usageIndex] == itemToFreeIndex );
		RED_ASSERT( m_usage[itemAtBack.m_usageIndex] == itemAtBackIndex );

		Swap( m_usage[itemToFree.m_usageIndex], m_usage[itemAtBack.m_usageIndex] );
		Swap( itemToFree.m_usageIndex, itemAtBack.m_usageIndex );

		itemToFree.m_usageIndex = -1;
		--m_numUsed;

		RED_ASSERT( !IsAllocated( id ) );
	}

	Uint32 GetReindexedItemId( const TRenderNodeGraphArray &importGraph, Uint32 importItemId ) const
	{
		RED_ASSERT( this != &importGraph );
		RED_ASSERT( importGraph.IsAllocated( importItemId ) );
		
		RED_ASSERT( m_numUsed >= importGraph.m_numUsed );
		const Uint32 usageOffset = m_numUsed - importGraph.m_numUsed;

		const Uint32 importItemIndex = importGraph.IdToIndex( importItemId );
		const Uint32 importUsageIndex = importGraph.m_items[importItemIndex].m_usageIndex;
		RED_ASSERT( importGraph.m_usage[importUsageIndex] == importItemIndex );

		const Uint32 thisUsageIndex = usageOffset + importUsageIndex;
		RED_ASSERT( thisUsageIndex < m_numUsed );
		const Uint32 thisItemIndex = m_usage[thisUsageIndex];
		RED_ASSERT( m_items[thisItemIndex].m_usageIndex == thisUsageIndex );

		RED_ASSERT( 0 != usageOffset || importItemIndex == thisItemIndex );
		return IndexToId( thisItemIndex );
	}

	Uint32 GetNumItems() const
	{
		return m_numUsed;
	}

	Uint32 GetItemIdByUsageIndex( Uint32 usageIndex ) const
	{
		RED_ASSERT( usageIndex < m_numUsed );
		RED_ASSERT( m_items[m_usage[usageIndex]].m_usageIndex == usageIndex );
		const Uint32 id = IndexToId( m_usage[usageIndex] );
		RED_ASSERT( usageIndex == GetItemUsageIndex(id) );
		return id;
	}

	Uint32 GetItemUsageIndex( Uint32 id ) const
	{
		RED_ASSERT( IsAllocated( id ) );
		Int32 usageIndex = m_items[ IdToIndex( id ) ].m_usageIndex;
		RED_ASSERT( usageIndex >= 0 );
		RED_ASSERT( usageIndex < (Int32)m_numUsed );
		RED_ASSERT( IdToIndex(id) == m_usage[usageIndex] );
		return (Uint32)usageIndex;
	}

	T& operator[]( Uint32 id )
	{
		RED_ASSERT( IsAllocated( id ) );
		return m_items[ IdToIndex( id ) ].m_data;
	}

	const T& operator[]( Uint32 id ) const
	{
		RED_ASSERT( IsAllocated( id ) );
		return m_items[ IdToIndex( id ) ].m_data;
	}

	void Reset()
	{
		// m_capacityStart
		// m_capacityGrow
		m_numUsed = 0;
		m_items.Clear();
		m_usage.Clear();
	}

private:
	const Uint32 m_capacityStart;
	const Uint32 m_capacityGrow;
	Uint32 m_numUsed;
	red::DynArray< DataWrapper > m_items{ rend::PoolRenderGraph() };
	red::DynArray< Uint32 > m_usage{ rend::PoolRenderGraph() }; //< indices to items, first <m_numUsed> ones are allocated (in use)
};

//********************************************************************************//
//********************************************************************************//
