// Set constant as object reflection for stage
template <Uint32 STAGE, typename T>
RED_FORCE_INLINE void SRenderNodeImplContext::SetConstant( const T& obj )
{
	// Unroll code using SetConstImpl implementation. Pass object
	// UnrollMask::call<bindImpl::SetConst<T>,STAGE,const T&>( std::forward<const T&>( obj ) );
	static_assert(sizeof( obj ) <= rend::Binding::Constants::SHARED_MAX_SIZE, "Struct is too big. Try to pack data");

	if(STAGE & eVERTEX)		GpuApi::SetVertexShaderConsts( obj );
	if(STAGE & ePIXEL)		GpuApi::SetPixelShaderConsts( obj );
	if(STAGE & eCOMPUTE)		GpuApi::SetComputeShaderConsts( obj );
}

RED_FORCE_INLINE void SRenderNodeImplContext::BindPSOImpl( PSO& pso )
{
	(void)pso;
}

template <typename ...Args>
RED_FORCE_INLINE void SRenderNodeImplContext::BindPSOImpl( PSO& pso, const BlankOutput&, const Args& ... args )
{
	pso.renderTargets.Reset();
	BindPSOImpl( pso, args... );
}

template <typename ...Args>
RED_FORCE_INLINE void SRenderNodeImplContext::BindPSOImpl( PSO& pso, const ColorTarget& colorTarget, const Args& ... args )
{
	pso.renderTargets.SetColorTarget( colorTarget.slot, colorTarget.texture, colorTarget.slice );
	BindPSOImpl( pso, args... );
}

template <typename ...Args>
RED_FORCE_INLINE void SRenderNodeImplContext::BindPSOImpl( PSO& pso, const NullColorTarget& colorTarget, const Args& ... args )
{
	pso.renderTargets.SetNullColorTarget();
	BindPSOImpl( pso, args... );
}

template <typename ...Args>
RED_FORCE_INLINE void SRenderNodeImplContext::BindPSOImpl( PSO& pso, const DepthTarget& depthTarget, const Args& ... args )
{
	pso.renderTargets.SetDepthStencilTarget( depthTarget.texture, depthTarget.slice, depthTarget.readOnly );
	BindPSOImpl( pso, args... );
}

template <typename ...Args>
RED_FORCE_INLINE void SRenderNodeImplContext::BindPSOImpl( PSO& pso, const UnorderedAccessView& uav, const Args& ... args )
{
	pso.renderTargets.SetUnorderedAccessView( uav.slot, uav.texture );
	BindPSOImpl( pso, args... );
}

template <typename ...Args>
RED_FORCE_INLINE void SRenderNodeImplContext::BindPSOImpl( PSO& pso, const UnorderedAccessViewBase& uavBase, const Args& ... args )
{
	pso.renderTargets.uavStartSlot = uavBase.baseSlot;
	BindPSOImpl( pso, args... );
}

template <typename ...Args>
RED_FORCE_INLINE void SRenderNodeImplContext::BindPSO( const Args& ... args ) const
{
	PSO pso;

	BindPSOImpl( pso, args... );

	GpuApi::SetupRenderTargets( pso.renderTargets );
	m_psoBound = true;
}

RED_FORCE_INLINE void SRenderNodeImplContext::SetViewport( const GpuApi::ViewportDesc& viewportDesc ) const
{
	// TODO: consider some overseeing here, allow/disallow nodes to set viewport.
	GpuApi::SetViewport( viewportDesc );
}

RED_FORCE_INLINE IRenderFrame* SRenderNodeImplContext::GetFrame() const 
{ 
	RED_FATAL_ASSERT( m_frame.Get(), "" );  
	return m_frame.Get(); 
}

RED_FORCE_INLINE TRenderFlowGroup SRenderNodeImplContext::GetRenderFlowGroup() const 
{ 
	return m_renderFlowGroup;
}

RED_FORCE_INLINE TRenderFlowSpace SRenderNodeImplContext::GetRenderFlowSpace() const 
{ 
	return m_renderFlowSpace; 
}

RED_FORCE_INLINE CRenderFlowResourceAllocator* SRenderNodeImplContext::GetResourceAllocator() const 
{ 
	RED_FATAL_ASSERT( m_resAlloc, "" ); 
	return m_resAlloc; 
}

RED_FORCE_INLINE const CRenderCamera& SRenderNodeImplContext::GetRenderCamera( ERenderingPlane plane ) const 
{ 
	return GetCameraData()->GetRenderCamera( plane );
}

