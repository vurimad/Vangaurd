RED_FORCE_INLINE Uint32 SRenderNodeImplContext::GetWidth() const 
{ 
	return GetCameraData()->GetResolutionState().GetInternalWidth();
}

RED_FORCE_INLINE Uint32 SRenderNodeImplContext::GetHeight() const
{ 
	return GetCameraData()->GetResolutionState().GetInternalHeight(); 
}

RED_FORCE_INLINE Uint32 SRenderNodeImplContext::GetMaxWidth() const
{
	return GetCameraData()->GetResolutionState().GetMaxInternalWidth();
}

RED_FORCE_INLINE Uint32 SRenderNodeImplContext::GetMaxHeight() const
{
	return GetCameraData()->GetResolutionState().GetMaxInternalHeight();
}

RED_FORCE_INLINE Uint32 SRenderNodeImplContext::GetFinalWidth() const
{
	return GetCameraData()->GetResolutionState().GetTargetWidth();
}

RED_FORCE_INLINE Uint32 SRenderNodeImplContext::GetFinalHeight() const
{
	return GetCameraData()->GetResolutionState().GetTargetHeight();
}

RED_FORCE_INLINE Uint32 SRenderNodeImplContext::GetPostAAWidth() const
{
#ifdef USE_DLSS
	return Test( RFF_DLSS ) ? GetFinalWidth() : GetWidth();
#else
	return GetWidth();
#endif // USE_DLSS
}

RED_FORCE_INLINE Uint32 SRenderNodeImplContext::GetPostAAHeight() const
{
#ifdef USE_DLSS
	return Test( RFF_DLSS ) ? GetFinalHeight() : GetHeight();
#else
	return GetHeight();
#endif // USE_DLSS
}

RED_FORCE_INLINE Uint32 SRenderNodeImplContext::GetPostAAMaxWidth() const
{
#ifdef USE_DLSS
	return Test( RFF_DLSS ) ? GetFinalWidth() : GetMaxWidth();
#else
	return GetMaxWidth();
#endif // USE_DLSS
}

RED_FORCE_INLINE Uint32 SRenderNodeImplContext::GetPostAAMaxHeight() const
{
#ifdef USE_DLSS
	return Test( RFF_DLSS ) ? GetFinalHeight() : GetMaxHeight();
#else
	return GetMaxHeight();
#endif // USE_DLSS
}

