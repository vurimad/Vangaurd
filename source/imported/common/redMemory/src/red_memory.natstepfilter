<?xml version="1.0" encoding="utf-8"?>  
<StepFilter xmlns="http://schemas.microsoft.com/vstudio/debugger/natstepfilter/2010">
    <Function>
        <Name>red::SharedPtr.*</Name>
        <Action>NoStepInto</Action>
    </Function>
    <Function>
        <Name>red::AtomicSharedPtr.*</Name>
        <Action>NoStepInto</Action>
    </Function>
    <Function>
        <Name>red::NonAtomicSharedPtr.*</Name>
        <Action>NoStepInto</Action>
    </Function>
    <Function>
        <Name>red::SharedStorage.*</Name>
        <Action>NoStepInto</Action>
    </Function>
    <Function>
        <Name>red::SharedStorage&lt;.*&gt;::Reset</Name>
        <Action>StepInto</Action>
    </Function>
    <Function>
        <Name>red::SharedStorage&lt;.*&gt;::Swap</Name>
        <Action>StepInto</Action>
    </Function>
    <Function>
        <Name>red::IntrusivePtr.*</Name>
        <Action>NoStepInto</Action>
    </Function>
    <Function>
        <Name>red::WeakPtr.*</Name>
        <Action>NoStepInto</Action>
    </Function>
    <Function>
        <Name>red::AtomicWeakPtr.*</Name>
        <Action>NoStepInto</Action>
    </Function>
    <Function>
        <Name>red::NonAtomicWeakPtr.*</Name>
        <Action>NoStepInto</Action>
    </Function>
    <Function>
        <Name>red::WeakStorage.*</Name>
        <Action>NoStepInto</Action>
    </Function>
    <Function>
        <Name>red::WeakStorage&lt;.*&gt;::Reset</Name>
        <Action>StepInto</Action>
    </Function>
    <Function>
        <Name>red::WeakStorage&lt;.*&gt;::Swap</Name>
        <Action>StepInto</Action>
    </Function>
    <Function>
        <Name>red::UniquePtr.*</Name>
        <Action>NoStepInto</Action>
    </Function>
    <Function>
        <Name>red::UniquePtr&lt;.*&gt;::Reset</Name>
        <Action>StepInto</Action>
    </Function>
    <Function>
        <Name>red::UniquePtr&lt;.*&gt;::Swap</Name>
        <Action>StepInto</Action>
    </Function>
    <Function>
        <Name>red::ScopedPtr.*</Name>
        <Action>NoStepInto</Action>
    </Function>
    <Function>
        <Name>red::UniqueBuffer.*</Name>
        <Action>NoStepInto</Action>
    </Function>
</StepFilter>