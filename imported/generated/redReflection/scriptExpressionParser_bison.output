Grammar

    0 $accept: statement $end

    1 statement: expression

    2 access: basic_access
    3       | array

    4 basic_access: TOKEN_IDENT
    5             | TOKEN_THIS
    6             | basic_access '.' TOKEN_IDENT
    7             | array '.' TOKEN_IDENT

    8 array_index: TOKEN_INTEGER
    9            | basic_access
   10            | array

   11 array_start: '['

   12 array_end: ']'

   13 array: basic_access array_start array_index array_end

   14 literal_token_base: TOKEN_BOOL_TRUE
   15                   | TOKEN_BOOL_FALSE
   16                   | TOKEN_INTEGER
   17                   | TOKEN_FLOAT
   18                   | TOKEN_NULL
   19                   | TOKEN_STRING
   20                   | TOKEN_NAME

   21 literal_token: literal_token_base

   22 basic_expression_component: literal_token
   23                           | access

   24 expression_component: basic_expression_component
   25                     | unary_expression
   26                     | binary_expression
   27                     | '(' expression_component ')'

   28 $@1: /* empty */

   29 unary_expression: '-' $@1 basic_expression_component

   30 $@2: /* empty */

   31 unary_expression: '-' $@2 '(' expression_component ')'
   32                 | '!' basic_expression_component
   33                 | '!' '(' expression_component ')'
   34                 | '~' basic_expression_component
   35                 | '~' '(' expression_component ')'

   36 binary_expression: expression_component '-' expression_component
   37                  | expression_component '+' expression_component
   38                  | expression_component '*' expression_component
   39                  | expression_component '/' expression_component
   40                  | expression_component '%' expression_component
   41                  | expression_component '&' expression_component
   42                  | expression_component '|' expression_component
   43                  | expression_component '^' expression_component
   44                  | expression_component '>' expression_component
   45                  | expression_component '<' expression_component
   46                  | expression_component TOKEN_OP_GREQ expression_component
   47                  | expression_component TOKEN_OP_LEEQ expression_component
   48                  | expression_component TOKEN_OP_EQUAL expression_component
   49                  | expression_component TOKEN_OP_NOTEQUAL expression_component
   50                  | expression_component TOKEN_OP_LOGIC_OR expression_component
   51                  | expression_component TOKEN_OP_LOGIC_AND expression_component

   52 expression: expression_component


