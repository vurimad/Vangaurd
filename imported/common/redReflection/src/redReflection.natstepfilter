<?xml version="1.0" encoding="utf-8"?>
<StepFilter xmlns="http://schemas.microsoft.com/vstudio/debugger/natstepfilter/2010">
    <Function>
        <Name>THandle.*</Name>
        <Action>NoStepInto</Action>
    </Function>
    <Function>
        <Name>WeakHandle.*</Name>
        <Action>NoStepInto</Action>
    </Function>
    <Function>
        <Name>HandleSharedStorage.*</Name>
        <Action>NoStepInto</Action>
    </Function>
    <Function>
        <Name>HandleSharedStorage&lt;.*&gt;::Reset</Name>
        <Action>StepInto</Action>
    </Function>
    <Function>
        <Name>HandleSharedStorage::Swap</Name>
        <Action>StepInto</Action>
    </Function>
</StepFilter>
